{
  "name": "gastos-compartidos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false && npm run typecheck:domain",
    "typecheck:domain": "tsc -p tsconfig.domain.json --pretty false",
    "test:domain": "vitest run --project=domain",
    "lint": "eslint src tests scripts *.ts *.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "node scripts/build-e2e.mjs && playwright test",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-gastos-compartidos",
    "test:rules": "firebase emulators:exec --only auth,firestore --project demo-gastos-compartidos \"node --test tests/rules/firestore.test.mjs\"",
    "icons": "python3 scripts/generate-icons.py",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "firebase-tools": "15.37.0",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12"
  }
}
