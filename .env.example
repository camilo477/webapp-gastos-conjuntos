# Demo works without this file. Values here are synthetic, not credentials.
# Copy to .env.local to use local Auth/trips/invitations during npm run dev.
VITE_FIREBASE_MODE=demo
VITE_FIREBASE_PROJECT_ID=demo-gastos-compartidos
VITE_FIREBASE_API_KEY=demo-not-a-real-api-key
VITE_FIREBASE_APP_ID=demo-not-a-real-app-id
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9199
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8180
